<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark red base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/screen_dark_red_base" />
        </shape>
    </item>
    <!-- Diagonal dark red wash, fading toward near-black at edges for depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="@color/screen_dark_red_mid"
                android:centerColor="@color/screen_dark_red_base"
                android:endColor="#0F0000" />
        </shape>
    </item>
    <!-- Moderate blood red glow, top center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="480dp"
                android:centerX="0.5"
                android:centerY="0.05"
                android:startColor="#4DB31217"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Secondary glow, bottom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.5"
                android:centerY="1.0"
                android:startColor="#337A0000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
