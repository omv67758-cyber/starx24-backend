<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_blood">
    <item>
        <layer-list>
            <!-- Transparent red glass fill: background bleeds through -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/btn_glass_fill" />
                    <corners android:radius="11dp" />
                    <stroke android:width="1.4dp" android:color="@color/blood_red" />
                </shape>
            </item>
            <!-- Red gloss highlight, top -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="@color/btn_sheen_red"
                        android:endColor="#00000000" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
