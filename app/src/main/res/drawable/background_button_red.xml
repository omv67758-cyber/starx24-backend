<?xml version="1.0" encoding="utf-8"?>
<!-- Primary CTA: flat, half-transparent red (matches the card family), no gradient. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_red">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wallet_flat_red_soft" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="@color/wallet_flat_red_border" />
        </shape>
    </item>
</ripple>
