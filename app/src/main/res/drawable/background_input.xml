<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wallet_flat_red_faint" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/wallet_flat_red_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wallet_input_bg" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/wallet_stroke_red_soft" />
        </shape>
    </item>
</selector>
