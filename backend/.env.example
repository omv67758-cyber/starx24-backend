# Render secrets: set these in the Environment tab, never in the Android app.
ZAPUPI_KEY=replace-with-your-zapupi-key
ZAPUPI_MODE=TEST
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# Optional alternative to the raw JSON above:
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
PUBLIC_BASE_URL=https://your-service.onrender.com